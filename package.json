  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "devDependencies": {
    "openclaw": ">=2026.9.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^24.0.0"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    }
  }
